# 部署配置：复制成 config.env 再改值
#   cp config.env.example config.env && vi config.env
# deploy.sh / check.sh 会自动读取同目录下的 config.env

# ============ 账号 ============
# API Token 需要：Account → Workers Scripts:Edit、Workers KV Storage:Edit、Account Settings:Read；
#                Zone    → Workers Routes:Edit
CF_TOKEN="REPLACE_WITH_TOKEN"
ACCOUNT_ID="REPLACE_WITH_ACCOUNT_ID"
ZONE_ID="REPLACE_WITH_ZONE_ID"

# ============ Worker ============
# 脚本名：建议中性名（别用协议名），多账号加后缀区分
SCRIPT="proxyx"

# 源码与 metadata（相对本目录）
WORKER_SRC="../_worker_v3.js"
META="./metadata.json"

# 1 = 部署前自动跑 build-obf.sh 用混淆包；0 = 直接部署明文源码
OBF=1

# ============ 访问入口 ============
# 空格分隔，第一个用于健康检查；必须属于上面的 zone
DOMAINS="a.example.com b.example.com"

CRON="*/30 * * * *"

# ============ 业务参数（写进 metadata.json，这里只是备忘） ============
UUID="REPLACE_WITH_UUID"
PWD="REPLACE_WITH_PASSWORD"
ADMIN_KEY="#REPLACE_WITH_ADMIN_KEY"
KV_TITLE="stats"

# 落盘加密种子：留空则 deploy.sh 自动生成（生成后务必备份！）
# 换了 KEK 等于换库，旧数据全部读不出来
KEK=""
